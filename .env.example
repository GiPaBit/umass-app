# ---------------------------------------------------------------------------
# Build-time (Vite inlines VITE_* into the bundle; copy to .env.local for dev)
# ---------------------------------------------------------------------------

# Google OAuth client ID for Calendar access (see README). Optional — the app runs
# without it, only the Google Calendar source is disabled.
VITE_GOOGLE_CLIENT_ID=

# Where /api lives. Empty means same origin, which is what you want for local dev
# and for the Docker image. Only the GitHub Pages build sets this, because Pages is
# static and cannot run api/*.js.
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Self-hosting (docker compose reads these from .env — copy this file to .env)
# ---------------------------------------------------------------------------

# Domain Caddy issues a certificate for. Must already resolve to this server, with
# ports 80 and 443 reachable from the internet.
DOMAIN=umass.example.com

# Origins allowed to read the API from a browser. Leave empty unless you are also
# serving the frontend from somewhere else — e.g. https://gipabit.github.io for the
# GitHub Pages copy.
ALLOWED_ORIGINS=
